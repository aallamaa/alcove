;; Project-local Alcove startup.
;; Keep the REPL quiet: no "In [n]:" input prompt and no "Out[n]:" result label.
;; The continuation prompt is EMPTY on purpose: prompt columns are undeletable,
;; so spaces there make a line at column 0 still look indented (and confuse the
;; REPL's own auto-indent). With "" the screen shows the real buffer.
(= *prompt-in* (fn (n) ""))
(= *prompt-out* (fn (n) ""))
(= *prompt-cont* (fn (n) ""))
